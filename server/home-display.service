# systemd servisi (Raspberry Pi / Linux sunucu). /etc/systemd/system/ altına kopyalayın.
[Unit]
Description=Kindle Home Display sunucusu
After=network-online.target

[Service]
WorkingDirectory=/opt/home_display/server
ExecStart=/usr/bin/python3 /opt/home_display/server/home_display.py serve
Restart=always
User=pi

[Install]
WantedBy=multi-user.target
